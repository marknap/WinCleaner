{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinCleaner for Gamers",
  "version": "0.2.0",
  "identifier": "com.marknap.wincleaner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WinCleaner for Gamers",
        "width": 1280,
        "height": 820,
        "minWidth": 1060,
        "minHeight": 680,
        "decorations": false,
        "center": true,
        "backgroundColor": "#07080f"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["English", "Dutch"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA5RjU1ODhBNTU2NjVCMTQKUldRVVcyWlZpbGoxQ1Mwc3JsKzBDNmMrQWlvU1ovSXhPRDhYQUg2Qm52My9Fc1dFL2Y5dEJQd1QK",
      "endpoints": ["https://github.com/marknap/WinCleaner/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
